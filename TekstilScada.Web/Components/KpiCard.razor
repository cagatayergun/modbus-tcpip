<div class="bg-gray-800 rounded-lg shadow-xl p-4 flex flex-col items-center justify-center text-center">
    <h3 class="text-sm font-semibold text-gray-400">@Title</h3>
    <p class="text-4xl font-bold text-white mt-2">@Value</p>
</div>

@code {
    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public string Value { get; set; }
}
