@using TekstilScada.Models
@using TekstilScada.Core.Services
@inject NavigationManager NavigationManager

<div class="bg-gray-800 text-white rounded-lg p-4 shadow-lg w-full max-w-sm mx-auto my-4 transition-transform transform hover:scale-105"
     style="min-width: 300px; min-height: 200px;">
    <div class="flex justify-between items-center mb-4">
        <div class="flex items-center">
            <span class="text-xl font-bold text-yellow-400 mr-2">@DisplayIndex.</span>
            <span class="text-xl font-semibold">@Machine.MachineName</span>
        </div>
        <div class="flex items-center space-x-2">
            @if (Machine.ConnectionState == ConnectionStatus.Connected)
            {
                <!-- Bağlantı ikonu -->
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-500 flex-shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" d="M12 21a9 9 0 100-18 9 9 0 000 18zm-.75-9a.75.75 0 01.75-.75h.75a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V12zm.75-6.75a.75.75 0 01.75.75v.75a.75.75 0 01-1.5 0V6a.75.75 0 01.75-.75z" clip-rule="evenodd" />
                </svg>

                <!-- Durum ikonları -->
                @if (Machine.HasActiveAlarm)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-500 flex-shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M9.401 3.003c1.155-2.003 4.301-2.003 5.456 0L21.5 12.5c1.155 2.003-.578 4.5-2.728 4.5H5.228c-2.15 0-3.883-2.497-2.728-4.5L9.4 3.003zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75z" clip-rule="evenodd" />
                    </svg>
                }
                else if (Machine.IsPaused)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-yellow-500 flex-shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M15.75 4.5a3 3 0 11.5 1.5H5.25a3 3 0 11-.5-1.5h11zM11.75 22.5a.75.75 0 01.75-.75H12a.75.75 0 010 1.5h-.75a.75.75 0 01-.75-.75zM12 20.25a.75.75 0 01.75-.75h.75a.75.75 0 01.75.75v.75a.75.75 0 01-1.5 0V20.25z" clip-rule="evenodd" />
                    </svg>
                }
                else if (Machine.IsInRecipeMode)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-500 flex-shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M5.25 6.364V5.25a.75.75 0 011.5 0v1.114a1 1 0 001.442.89L13.5 9.873V1.5a.75.75 0 011.5 0v8.373a1 1 0 001.442-.89V6.364a.75.75 0 011.5 0v.75A2.25 2.25 0 0116.5 9.364h-1.5a.75.75 0 01-.75-.75V1.5A.75.75 0 0113.5 1.5v7.114a1 1 0 00-1.442.89L6.75 12.873v9.627a.75.75 0 01-1.5 0v-9.627a1 1 0 00-1.442-.89L2.25 10.373V1.5A.75.75 0 011.5 1.5v8.873a1 1 0 001.442.89L6.75 14.873z" />
                    </svg>
                }
            }
            else
            {
                <!-- Bağlantı yok ikonu -->
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-500 flex-shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" d="M12 21a9 9 0 100-18 9 9 0 000 18zm-.75-9a.75.75 0 01.75-.75h.75a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V12zm.75-6.75a.75.75 0 01.75.75v.75a.75.75 0 01-1.5 0V6a.75.75 0 01.75-.75z" clip-rule="evenodd" />
                </svg>
            }
        </div>
    </div>

    <div class="space-y-2 mb-4">
        <div class="flex justify-between items-center text-sm">
            <span class="text-gray-400">Reçete:</span>
            <span class="font-medium">@(string.IsNullOrEmpty(Machine.RecipeName) ? "Reçete Yüklü Değil" : Machine.RecipeName)</span>
        </div>
        <div class="flex justify-between items-center text-sm">
            <span class="text-gray-400">Operatör:</span>
            <span class="font-medium">@Machine.OperatorIsmi</span>
        </div>
        <div class="flex justify-between items-center text-sm">
            <span class="text-gray-400">Aktif Adım:</span>
            <span class="font-medium">@Machine.AktifAdimAdi</span>
        </div>
    </div>

    <div class="relative w-full h-6 bg-gray-600 rounded-full overflow-hidden">
        <div class="absolute h-full bg-blue-500 transition-all duration-300 ease-in-out" style="width: @(Machine.ProsesYuzdesi)%;"></div>
        <span class="absolute inset-0 flex items-center justify-center text-xs font-semibold text-white">@Machine.ProsesYuzdesi %</span>
    </div>

    <div class="flex justify-between mt-4 space-x-2">
        <button @onclick="ShowDetails" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition-colors">
            Detaylar
        </button>
        <button @onclick="RequestVnc" class="flex-1 bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded-lg transition-colors">
            VNC
        </button>
    </div>
</div>

@code {
    [Parameter]
    public FullMachineStatus Machine { get; set; }

    [Parameter]
    public int DisplayIndex { get; set; }

    private void ShowDetails()
    {
        if (Machine?.MachineId > 0)
        {
            NavigationManager.NavigateTo($"/proses-izleme/{Machine.MachineId}");
        }
    }

    private void RequestVnc()
    {
        // VNC bağlantısı için mantık buraya gelecek.
        // Windows Forms'da olduğu gibi doğrudan bir VNC istemcisi açmak mümkün değil,
        // ancak kullanıcıya bir uyarı mesajı gösterebilir veya bir API çağrısı yapabilirsiniz.
        // alert() kullanılamadığı için, özel bir modal pencere veya toast bildirimi kullanın.
    }
}
