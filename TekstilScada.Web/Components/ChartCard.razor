@using TekstilScada.Web.Models
@typeparam TData

<div class="card">
    <div class="card-header fw-bold">@Title</div>
    <div class="card-body">
        @if (Data != null && Data.Labels != null && Data.Values != null)
        {
            <!-- Basit bir tablo ile örnek gösterim -->
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Etiket</th>
                        <th>Değer</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Data.Labels.Count; i++)
                    {
                        <tr>
                            <td>@Data.Labels[i]</td>
                            <td>@Data.Values[i]</td>
                        </tr>
                    }
                </tbody>
            </table>
            <!-- Gerçek projede Chart.js, Blazorise Chart, RadzenChart gibi bir grafik kütüphanesiyle görselleştirme yapılmalı -->
        }
        else
        {
            <div>Veri yok</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; }
    [Parameter] public ChartData Data { get; set; }
}