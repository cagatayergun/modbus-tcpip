<div class="dashboard-machine-card">
    <div class="status-indicator" style="background-color: @GetStatusColor(Status);"></div>
    <div class="card-content">
        <div class="header">
            <span class="machine-name">@MachineName</span>
            <span class="status-text" style="color: @GetStatusColor(Status);">@Status</span>
        </div>
        <div class="details">
            <span class="recipe-name">Reçete: @RecipeName</span>
            <span class="batch-id">Parti: @BatchId</span>
        </div>
        <div class="sensor-data">
            <div class="temperature">@Temperature</div>
            <div class="rpm-gauge">
                <div class="rpm-value">@RpmValue</div>
                <div class="rpm-text">RPM</div>
            </div>
        </div>
        <div class="sparkline-placeholder">
            <p>Sparkline Grafiği</p>
        </div>
    </div>
</div>

<style>
    .dashboard-machine-card {
        display: flex;
        border: 1px solid #ccc;
        border-radius: 5px;
        background-color: #fffff0; /* SystemColors.Info */
        width: 300px; /* Genişlik kısıtlaması */
        height: 180px;
        margin: 5px;
    }

    .status-indicator {
        width: 12px;
        height: 100%;
        border-radius: 5px 0 0 5px;
    }

    .card-content {
        flex: 1;
        padding: 10px;
        display: flex;
        flex-direction: column;
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 5px;
    }

    .machine-name {
        font-weight: bold;
        font-size: 1.1rem;
    }

    .status-text {
        font-weight: bold;
        font-size: 0.9rem;
    }

    .details {
        font-size: 0.8rem;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .sensor-data {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }

    .temperature {
        font-size: 2rem;
        font-weight: bold;
        color: #404040;
    }

    .rpm-gauge {
        width: 80px;
        height: 80px;
        border: 10px solid #ddd;
        border-radius: 50%;
        border-top-color: #2ecc71; /* Örnek RPM rengi */
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        .rpm-gauge .rpm-value {
            font-weight: bold;
            font-size: 1.2rem;
        }

        .rpm-gauge .rpm-text {
            font-size: 0.7rem;
            margin-top: -5px;
        }

    .sparkline-placeholder {
        border-top: 1px dashed #ccc;
        margin-top: auto;
        padding-top: 5px;
        text-align: center;
        font-size: 0.8rem;
    }
</style>

@code {
    [Parameter]
    public string MachineName { get; set; }

    [Parameter]
    public string Status { get; set; }

    [Parameter]
    public string RecipeName { get; set; }

    [Parameter]
    public string BatchId { get; set; }

    [Parameter]
    public string Temperature { get; set; }

    [Parameter]
    public string RpmValue { get; set; }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "ÇALIŞIYOR" => "#2ecc71",
            "DURUYOR" => "#e74c3c",
            _ => "#95a5a6", // Varsayılan renk
        };
    }
}