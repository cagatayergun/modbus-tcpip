@page "/main"

<div class="h-screen flex flex-col">
    <!-- Üst menü -->
    <header class="bg-blue-700 text-white p-4 flex justify-between items-center shadow-md">
        <h1 class="text-xl font-bold">Tekstil SCADA - Ana Ekran</h1>
        <button class="bg-red-500 px-4 py-2 rounded hover:bg-red-600" @onclick="Logout">
            Çıkış
        </button>
    </header>

    <!-- İçerik -->
    <main class="flex-1 p-6 grid grid-cols-3 gap-6 bg-gray-100">
        <div class="bg-white rounded-2xl shadow p-4 hover:shadow-lg cursor-pointer" @onclick="GoToProcess">
            <h2 class="text-lg font-semibold mb-2">Proses İzleme</h2>
            <p class="text-gray-600">Makine durumlarını canlı izle</p>
        </div>

        <div class="bg-white rounded-2xl shadow p-4 hover:shadow-lg cursor-pointer" @onclick="GoToProduction">
            <h2 class="text-lg font-semibold mb-2">Üretim Detay</h2>
            <p class="text-gray-600">Üretim verilerini gör</p>
        </div>

        <div class="bg-white rounded-2xl shadow p-4 hover:shadow-lg cursor-pointer" @onclick="GoToFtp">
            <h2 class="text-lg font-semibold mb-2">FTP Senkronizasyon</h2>
            <p class="text-gray-600">Veri aktarımını yönet</p>
        </div>
    </main>
</div>

@code {
    private void Logout()
    {
        // TODO: Token temizlenecek
        Navigation.NavigateTo("/login");
    }

    private void GoToProcess() => Navigation.NavigateTo("/prosesizleme");
    private void GoToProduction() => Navigation.NavigateTo("/productiondetail");
    private void GoToFtp() => Navigation.NavigateTo("/ftpsync");

    [Inject] private NavigationManager Navigation { get; set; } = default!;
}
