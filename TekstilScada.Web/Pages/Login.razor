@page "/login"
@using System.Net.Http.Json
@using TekstilScada.Web.Models
@using TekstilScada.Web.Auth
@using Microsoft.AspNetCore.Components.Authorization // Bu satırı ekle
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<h3>Login</h3>

<div class="card">
    <div class="card-body">
        <EditForm Model="@loginModel" OnValidSubmit="@OnLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (ShowAuthError)
            {
                <div class="alert alert-danger">@Error</div>
            }

            <div class="form-group">
                <label for="username">Username</label>
                <InputText id="username" class="form-control" @bind-Value="loginModel.Username" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
            </div>

            <button type="submit" class="btn btn-primary mt-2">Login</button>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private bool ShowAuthError { get; set; }
    private string Error { get; set; }

    public async Task OnLogin()
    {
        ShowAuthError = false;

        var result = await Http.PostAsJsonAsync("api/Auth/login", loginModel);

        if (result.IsSuccessStatusCode)
        {
            var tokenResponse = await result.Content.ReadFromJsonAsync<TokenResponse>();

            // AuthStateProvider'ı token ile güncelle
            await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(tokenResponse.Token);

            NavManager.NavigateTo("/", true);
        }
        else
        {
            Error = "Kullanıcı adı veya şifre hatalı.";
            ShowAuthError = true;
        }
    }

    public class TokenResponse
    {
        public string Token { get; set; }
    }
}