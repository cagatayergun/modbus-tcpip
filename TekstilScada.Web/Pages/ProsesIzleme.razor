@page "/proses-izleme/{MachineId:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@using TekstilScada.Models
@inject HttpClient Http




<PageTitle>Proses İzleme - @(makineDetay?.MachineName ?? "Yükleniyor...")</PageTitle>

@if (makineDetay == null)
{
    <p class.loading-text><em>Makine detayları yükleniyor...</em></p>
}
else
{
    <div class="proses-header">
        <h1>@makineDetay.MachineName</h1>
        <div class="status-badge @GetStatusCssClass(GetStatus(makineDetay))">
            @GetStatus(makineDetay)
        </div>
    </div>

    <div class="proses-grid">
        <div class="proses-card">
            <h3>Anlık Değerler</h3>
            <div class="value-grid">
                <div class="value-item">
                    <span class="label">Sıcaklık</span>
                    <span class="value">@makineDetay.AnlikSicaklik °C</span>
                </div>
                <div class="value-item">
                    <span class="label">Devir</span>
                    <span class="value">@makineDetay.AnlikDevirRpm RPM</span>
                </div>
                <div class="value-item">
                    <span class="label">Su Seviyesi</span>
                    <span class="value">@makineDetay.AnlikSuSeviyesi L</span>
                </div>
                <div class="value-item">
                    <span class="label">Proses Yüzdesi</span>
                    <span class="value">% @makineDetay.ProsesYuzdesi</span>
                </div>
            </div>
        </div>

        <div class="proses-card">
            <h3>Aktif Reçete Bilgileri</h3>
            <div class="value-grid">
                <div class="value-item">
                    <span class="label">Reçete Adı</span>
                    <span class="value">@(string.IsNullOrEmpty(makineDetay.RecipeName) ? "Reçete Yüklü Değil" : makineDetay.RecipeName)</span>
                </div>
                <div class="value-item">
                    <span class="label">Aktif Adım</span>
                    <span class="value">@makineDetay.AktifAdimNo</span>
                </div>
                <div class="value-item">
                    <span class="label">Adım Adı</span>
                    <span class="value">@makineDetay.AktifAdimAdi</span>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter]
    public int MachineId { get; set; }

    private FullMachineStatus makineDetay;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Adresten gelen ID'yi kullanarak API'den ilgili makinenin verilerini çekiyoruz.
            makineDetay = await Http.GetFromJsonAsync<FullMachineStatus>($"api/Machine/GetMachineStatus/{MachineId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Makine detayı çekilirken hata oluştu: {ex.Message}");
            // Burada kullanıcıya hata mesajı göstermek için bir değişken set edilebilir.
        }
    }

    private string GetStatus(FullMachineStatus status)
    {
        if (status == null) return "BİLİNMİYOR";
        if (status.ConnectionState != ConnectionStatus.Connected) return "BAĞLANTI YOK";
        if (status.HasActiveAlarm) return "ARIZA";
        if (status.IsPaused) return "BEKLEMEDE";
        if (status.IsMachineInProduction) return "ÇALIŞIYOR";
        if (status.IsInRecipeMode) return "REÇETEDE";
        return "DURDU";
    }

    private string GetStatusCssClass(string status)
    {
        return status switch
        {
            "ÇALIŞIYOR" => "status-running",
            "DURDU" => "status-stopped",
            "ARIZA" => "status-error",
            "BEKLEMEDE" => "status-idle",
            _ => "status-unknown"
        };
    }
}