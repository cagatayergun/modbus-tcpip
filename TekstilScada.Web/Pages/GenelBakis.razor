@page "/genel-bakis"
@using TekstilScada.Web.Models

@inject IGenelBakisService GenelBakisService

@if (Kpis == null || MachineGroups == null)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
        <div>Yükleniyor...</div>
    </div>
}
else
{
    <div class="container-fluid py-3">
        <!-- Üst KPI Kartları -->
        <div class="row mb-3">
            @foreach (var kpi in Kpis)
            {
                <div class="col-md-3 mb-2">
                    <KpiCard Title="@kpi.Title" Value="@kpi.Value" Color="@kpi.Color" />
                </div>
            }
        </div>

        <div class="row">
            <!-- Makine Grupları -->
            <div class="col-lg-8">
                @foreach (var group in MachineGroups)
                {
                    <div class="card mb-3" style="background-color:@group.Color">
                        <div class="card-header text-white fw-bold">@group.Name</div>
                        <div class="card-body d-flex flex-row flex-nowrap overflow-auto p-2" style="gap: 1rem; min-height: 180px;">
                            @foreach (var machine in group.Machines)
                            {
                                <DashboardMachineCard 
                                    MachineName="@machine.MachineName"
                                    Status="@machine.Status"
                                    RecipeName="@machine.RecipeName"
                                    BatchId="@machine.BatchId"
                                    Temperature="@machine.Temperature"
                                    RpmValue="@machine.RpmValue" />
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Sağ Panel: Grafikler -->
            <div class="col-lg-4">
                <div class="mb-3">
                    <ChartCard Title="Saatlik Elektrik Tüketimi" Data="@HourlyElectric" />
                </div>
                <div class="mb-3">
                    <ChartCard Title="Saatlik Su Tüketimi" Data="@HourlyWater" />
                </div>
                <div class="mb-3">
                    <ChartCard Title="Saatlik Buhar Tüketimi" Data="@HourlySteam" />
                </div>
                <div class="mb-3">
                    <ChartCard Title="Son 24 Saatin Popüler Alarmları" Data="@TopAlarms" />
                </div>
                <div>
                    <ChartCard Title="Son 24 Saatin OEE Ortalaması" Data="@HourlyOee" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<KpiViewModel>? Kpis;
    private List<MachineGroupViewModel>? MachineGroups;
    private ChartData? HourlyElectric, HourlyWater, HourlySteam, TopAlarms, HourlyOee;

    protected override async Task OnInitializedAsync()
    {
        Kpis = await GenelBakisService.GetKpisAsync();
        MachineGroups = await GenelBakisService.GetMachineGroupsAsync();
        HourlyElectric = await GenelBakisService.GetHourlyElectricAsync();
        HourlyWater = await GenelBakisService.GetHourlyWaterAsync();
        HourlySteam = await GenelBakisService.GetHourlySteamAsync();
        TopAlarms = await GenelBakisService.GetTopAlarmsAsync();
        HourlyOee = await GenelBakisService.GetHourlyOeeAsync();
    }
}