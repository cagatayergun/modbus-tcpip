

@page "/genel-bakis"
@using Microsoft.AspNetCore.Authorization 
@attribute [Authorize]
<h3>Genel Bakış</h3>

<div class="scada-dashboard-header">
    <KpiCard Title="Toplam Makine Sayısı" Value="5" Color="#3498db" />
    <KpiCard Title="Çalışan Makine Sayısı" Value="3" Color="#2ecc71" />
    <KpiCard Title="Durmuş Makine Sayısı" Value="2" Color="#e74c3c" />
    <KpiCard Title="Ortalama OEE" Value="85.5%" Color="#f39c12" />
</div>

<div class="scada-dashboard-main">
    <div class="scada-machine-group-container">
        <DashboardMachineCard MachineName="Makine 1" Status="ÇALIŞIYOR" RecipeName="Kumaş Yıkama" BatchId="Batch-001" Temperature="95 °C" RpmValue="450" />
        <DashboardMachineCard MachineName="Makine 2" Status="DURUYOR" RecipeName="-" BatchId="-" Temperature="30 °C" RpmValue="0" />
        <DashboardMachineCard MachineName="Makine 3" Status="ÇALIŞIYOR" RecipeName="Boyama" BatchId="Batch-002" Temperature="80 °C" RpmValue="300" />
    </div>

    <div class="scada-sidebar">
        <div class="scada-group-box">
            <legend>Saatlik Elektrik Tüketimi</legend>
            <div class="plot-placeholder">Grafik Alanı</div>
        </div>
        <div class="scada-group-box">
            <legend>Saatlik Su Tüketimi</legend>
            <div class="plot-placeholder">Grafik Alanı</div>
        </div>
        <div class="scada-group-box">
            <legend>Saatlik Buhar Tüketimi</legend>
            <div class="plot-placeholder">Grafik Alanı</div>
        </div>
        <div class="scada-group-box">
            <legend>Son 24 Saatin Popüler Alarmları</legend>
            <div class="plot-placeholder">Grafik Alanı</div>
        </div>
        <div class="scada-group-box">
            <legend>Son 24 Saatin OEE Ortalaması</legend>
            <div class="plot-placeholder">Grafik Alanı</div>
        </div>
    </div>
</div>