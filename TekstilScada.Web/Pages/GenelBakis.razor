@page "/genel-bakis"
@using TekstilScada.Web.Components
@using TekstilScada.Web.Models
@inject HttpClient Http

<PageTitle>Genel Bakış</PageTitle>

<div class="p-6 bg-gray-900 min-h-screen text-white">
    <h1 class="text-3xl font-bold text-gray-100 mb-6 border-b border-gray-700 pb-2">Genel Bakış</h1>

    @if (kpiData == null)
    {
        <div class="flex items-center justify-center p-10 rounded-lg shadow-inner bg-gray-800">
            <span class="text-gray-400 text-lg">Veriler yükleniyor...</span>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <KpiCard Title="Toplam Makine Sayısı" Value="@kpiData.TotalMachineCount.ToString()" />
            <KpiCard Title="Çalışan Makine Sayısı" Value="@kpiData.RunningMachineCount.ToString()" />
            <KpiCard Title="Durdu Makine Sayısı" Value="@kpiData.StoppedMachineCount.ToString()" />
            <KpiCard Title="Alarmdaki Makine Sayısı" Value="@kpiData.AlarmedMachineCount.ToString()" />
        </div>
    }
</div>

@code {
    private KpiViewModel kpiData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // API'den KPI verilerini çekiyoruz. Bu endpoint'in API projesinde tanımlanması gerekmektedir.
            kpiData = await Http.GetFromJsonAsync<KpiViewModel>("api/Dashboard/GetKpiData");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"KPI verileri çekilirken hata oluştu: {ex.Message}");
            // Hata mesajı göstermek için bir mekanizma ekleyebilirsiniz.
        }
    }
}
