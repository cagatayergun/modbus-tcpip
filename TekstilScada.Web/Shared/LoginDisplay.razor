@using Microsoft.AspNetCore.Components.Authorization
<AuthorizeView>
    <Authorized>
        <span class="text-light">Merhaba, @context.User.Identity?.Name!</span>
        <a href="logout">Çıkış Yap</a>
    </Authorized>
    <NotAuthorized>
        <a href="login">Giriş Yap</a>
    </NotAuthorized>
</AuthorizeView>