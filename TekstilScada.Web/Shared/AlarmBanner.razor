@inject HttpClient Http

<div class="alarm-banner">
    <div class="alarm-title">AKTİF ALARMLAR</div>
    <div class="alarm-list">
        @if (alarmlar == null)
        {
            <span>Yükleniyor...</span>
        }
        else if (alarmlar.Length == 0)
        {
            <span class="no-alarm">Aktif alarm bulunmuyor.</span>
        }
        else
        {
            @foreach (var alarm in alarmlar)
            {
                <div class="alarm-item @alarm.Severity.ToLower()">
                    <span class="time">@alarm.Timestamp.ToString("HH:mm:ss")</span>
                    <span class="machine">@alarm.MachineName</span>
                    <span class="text">@alarm.AlarmText</span>
                </div>
            }
        }
    </div>
</div>

@code {
    // Şimdilik sahte alarm verileri kullanıyoruz.
    private Alarm[] alarmlar;

    protected override void OnInitialized()
    {
        alarmlar = new Alarm[]
        {
            new Alarm { Timestamp = DateTime.Now.AddSeconds(-10), MachineName = "Makine 1", AlarmText = "Basınç çok yüksek!", Severity = "High" },
            new Alarm { Timestamp = DateTime.Now.AddSeconds(-30), MachineName = "Makine 3", AlarmText = "Sıcaklık sensör hatası", Severity = "Medium" },
            new Alarm { Timestamp = DateTime.Now.AddSeconds(-120), MachineName = "Makine 1", AlarmText = "Filtre tıkalı", Severity = "Low" }
        };
    }

    // Bu modelleri daha sonra API'den gelecek şekilde TekstilScada.Core projesine taşıyabiliriz.
    public class Alarm
    {
        public DateTime Timestamp { get; set; }
        public string MachineName { get; set; }
        public string AlarmText { get; set; }
        public string Severity { get; set; } // High, Medium, Low
    }
}