@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* Buraya kullanıcı adı ve giriş/çıkış butonu gelecek *@
            <LoginDisplay />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>

    <footer class="alarm-footer">
        @* Buraya alt alarm paneli gelecek *@
        <AlarmBanner />
    </footer>
</div>