@inherits LayoutComponentBase
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using TekstilScada.WebApp.Services
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager NavigationManager 

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            
            @* --- 2. ÇIKIŞ YAP BUTONUNU EKLE --- *@
            <button class="btn btn-link nav-link" @onclick="HandleLogout">Çıkış Yap</button>
            
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">Hakkında</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
...
@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthProvider.InitializeAuthenticationStateAsync();
    }

    // --- 3. BUTONUN METODUNU EKLE ---
    private async Task HandleLogout()
    {
        await AuthProvider.LogoutAsync();
        NavigationManager.NavigateTo("/login", true); // Çıkış yapınca login'e zorla
    }
}